{
  "name": "tsv-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime",
    "db:reset": "supabase db reset",
    "demo:photos": "node --env-file=.env.local --import tsx scripts/demo-photos.ts",
    "photos": "node --env-file=.env.local --import tsx scripts/photos.ts",
    "photos:prod": "node --env-file=.env.prod --import tsx scripts/photos.ts",
    "import:instagram": "node --env-file=.env.local --import tsx scripts/import-instagram.ts",
    "import:instagram:prod": "node --env-file=.env.prod --import tsx scripts/import-instagram.ts",
    "setup:telegram": "node --env-file=.env.prod --import tsx scripts/setup-telegram.ts"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "^0.35.5",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.13"
  }
}
